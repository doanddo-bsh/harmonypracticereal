<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AD_ID 권한 추가 -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <application
        android:label="화성박사"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7191096510845066~9371808501"/>
        <!-- 여기 있던 android.adservices.AD_SERVICES_CONFIG tools:replace 블록은
             제거했다. Task 4 당시에는 play-services-measurement-api 와
             play-services-ads-lite 가 이 property 를 서로 다른 리소스로 선언해
             매니페스트 병합이 실패했다. 이번 업그레이드 후에는 양쪽 다 이 선언을
             하지 않는다 — play-services-ads-lite 는 25.x 에서 사라졌고,
             play-services-ads 25.3.0 과 play-services-measurement-api 23.2.0
             둘 다 AD_SERVICES_CONFIG 도 res/xml 도 갖고 있지 않다.
             즉 병합 충돌 자체가 없어졌고, @xml/gma_ad_services_config 은 이제
             존재하지 않는 리소스라 그대로 두면 리소스 링킹이 실패한다. -->
    </application>
</manifest>
